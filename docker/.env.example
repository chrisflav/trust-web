# Copy to `.env` and fill in.  `docker compose` reads it from this directory.

# The one origin the frontend and the node share.  It is baked into the
# frontend bundle at build time, it is what the node calls itself when it talks
# to peers, and it is what the GitHub OAuth callback has to match — so it is
# the same value in all three places, and that is the point of there being one.
PUBLIC_URL=https://trust.example.org
APP_URL=https://trust.example.org

# A GitHub OAuth App.  Its callback must be exactly:
#   ${PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# At least 32 characters:  openssl rand -hex 32
SESSION_SECRET=

# The name this node publishes in its §2 descriptor.
NODE_NAME=trust

# Behind TLS, so the session cookie is marked Secure.
COOKIE_SECURE=true

# The containers must not be reachable past the proxy: it holds the TLS, the
# redirects and the security headers, and binding anything but loopback here
# lets all three be walked straight past.
BIND_ADDR=127.0.0.1
SERVER_PORT=8099
WEB_PORT=5174

# Where `trust export` writes.  Bind-mounted read-only into the web container
# and served at /index/; replacing a directory under it publishes a new index
# without rebuilding anything.
INDEX_DIR=../public/index

# Nodes this one talks to, and the token for the endpoints that change that.
# Both empty by default: federating with strangers, or letting them ask you to,
# should be something you decided rather than something you inherited.
FEDERATION_SEEDS=
FEDERATION_AUTODISCOVER=false
ADMIN_TOKEN=
